{"nodes": [{"id": "src_app_lawnchair_ui_preferences_components_readme_components_directory_organization", "label": "Components Directory Organization", "file_type": "rationale", "source_file": "src/app/lawnchair/ui/preferences/components/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The preferences `components` directory should be organized by purpose/complexity: components for a specific UI needing many files get their own subdirectory (e.g. `colorpreference`); components that let the user control/select something go in `controls`; components related to layout itself go in `layout`; everything else stays in the root `components` directory. This keeps the components directory navigable as it grows."}, {"id": "src_app_lawnchair_ui_preferences_components_readme_controls_subdirectory", "label": "controls Subdirectory Convention", "file_type": "concept", "source_file": "src/app/lawnchair/ui/preferences/components/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_app_lawnchair_ui_preferences_components_readme_layout_subdirectory", "label": "layout Subdirectory Convention", "file_type": "concept", "source_file": "src/app/lawnchair/ui/preferences/components/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_app_lawnchair_ui_preferences_components_readme_colorpreference_subdirectory", "label": "colorpreference Subdirectory (Example)", "file_type": "concept", "source_file": "src/app/lawnchair/ui/preferences/components/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_app_lawnchair_ui_preferences_components_readme_components_directory_organization", "target": "src_app_lawnchair_ui_preferences_components_readme_controls_subdirectory", "relation": "refe